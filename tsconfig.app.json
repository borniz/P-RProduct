/* To learn more about Typescript configuration file: https://typescriptlang.org. */
/* To learn more about Angular compiler options: https://angular.dev. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    // 📌 SOLUCIÓN AL ERROR DE LA IMAGEN: Se inyecta './' al inicio de las rutas 
    // para cumplir con la sintaxis obligatoria de TypeScript 6.0 sin depender de baseUrl
    "paths": {
      "@core/*": ["./src/app/core/*"],
      "@features/*": ["./src/app/features/*"]
    }
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
